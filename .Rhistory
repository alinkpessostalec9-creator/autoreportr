data = USJudgeRatings
# b. obtenir la matrice des corrélations
matricecor = cor(data)
print(matricecor)
n = nrow(data) # nombre de lignes ---> nombre d'individus
p = ncol(data) # nombre de colonnes ---> nombre de variables
Bartlett = -(n-1-((2*p+5)/6))*log(abs(det(matricecor)))
print(Bartlett)
# degré de liberté
ddl=(p*(p-1))/2
print(ddl)
## calcul de la p-value
p.value = pchisq(Bartlett,ddl,lower.tail=F)
print(p.value)
acp = PCA(data, scale.unit=TRUE, graph=TRUE)
print(acp)
