# Script complet incluant la variable qualitative comme illustratif
library(FactoMineR)
# ACP sur les variables quantitatives
res.pca <- PCA(iris[,1:4], scale.unit = TRUE, graph = FALSE)
# Lancement de l'interface interactive
# Vous pouvez ajouter l'espèce comme variable illustrative
resshiny <- PCAshiny(res.pca)
