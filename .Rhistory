cci = TTR::CCI(cbind(plus_haut, plus_bas, cloture), n = 20),
# Force de la tendance
trend_strength = abs(sma_20 - sma_50) / sma_20,
# Distance par rapport aux moyennes mobiles
dist_sma20 = (cloture - sma_20) / sma_20,
dist_sma50 = (cloture - sma_50) / sma_50,
dist_sma200 = (cloture - sma_200) / sma_200
)
return(df)
}
# Fonction pour calculer les métriques de risque/performance
calculer_metriques_risque <- function(returns) {
returns <- na.omit(returns)
if (length(returns) < 20) {
return(list(
sharpe_ratio = NA,
sortino_ratio = NA,
calmar_ratio = NA,
max_drawdown = NA,
var_95 = NA,
cvar_95 = NA
))
}
# Calcul des métriques
result <- list(
sharpe_ratio = PerformanceAnalytics::SharpeRatio.annualized(returns, scale = 252),
sortino_ratio = PerformanceAnalytics::SortinoRatio(returns),
calmar_ratio = PerformanceAnalytics::CalmarRatio(returns),
max_drawdown = PerformanceAnalytics::maxDrawdown(returns),
var_95 = quantile(returns, probs = 0.05),
cvar_95 = mean(returns[returns <= quantile(returns, 0.05)])
)
return(result)
}
