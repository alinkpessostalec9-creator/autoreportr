\alias{autoreportr-package}
\docType{package}
\title{AutoReportR v2.0: Automatic Statistical Reporting with AI}
\description{
  AutoReportR v2.0 generates professional HTML statistical reports with:
  \itemize{
    \item Automatic descriptive statistics (numeric and categorical variables)
    \item AI-powered interpretations via Groq API (Llama 3.3-70B)
    \item Missing values analysis with interactive tables
    \item Responsive HTML design with hover effects
    \item Automatic detection of variable types
  }
  Perfect for quick data exploration and automated reporting.
}
\author{
  Stalec Alinkpesso
}
