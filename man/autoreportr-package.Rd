\name{autoreportr-package}
\alias{autoreportr}
\alias{autoreportr-package}
\docType{package}
\title{AutoReportR: Automatic Statistical Reporting}
\description{
  AutoReportR generates beautiful HTML statistical reports with interactive
  cards, univariate statistics, missing data analysis, and automatic
  interpretations. The reports are responsive, include hover effects,
  and work well on both desktop and mobile devices.
}
